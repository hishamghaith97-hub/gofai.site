# Copy to .env.local and fill in.

# Auth.js: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` (or any random 32+ character string)
AUTH_SECRET=
# Your app's public URL. Optional on Vercel; needed elsewhere.
# AUTH_URL=http://localhost:3000

# Only emails on these domains can sign in (comma separated, exact match)
ALLOWED_EMAIL_DOMAINS=gofai.site

# MongoDB (e.g. MongoDB Atlas connection string)
MONGODB_URI=
MONGODB_DB=aisystem

# Resend: API key, and a sender on a domain verified in Resend
AUTH_RESEND_KEY=
EMAIL_FROM="GOF.ai <login@gofai.site>"

# Trigger.dev (only needed once automations exist)
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
